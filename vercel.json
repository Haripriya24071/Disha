{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd mobile-app && npm install && npm run build",
  "outputDirectory": "mobile-app/dist",
  "rewrites": [
    {
      "source": "/api/journey/:pnr",
      "destination": "/api/journey/[pnr]"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/index.html"
    }
  ]
}
